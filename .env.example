# shm-mcp конфигурация
# Скопируйте в .env и заполните. .env никогда не коммитится (см. .gitignore).
# Агенты-разработчики .env не создают и креды не имеют.

# Базовый URL панели SHM. Уже ДОЛЖЕН включать суффикс /shm/v1 —
# пути из спеки ("/admin/user", "/user/service") относительные и просто
# дописываются к этому значению.
SHM_BASE_URL=https://admin.example.com/shm/v1

# Basic-авторизация администратора SHM в формате "login:password".
# Взаимоисключающе с SHM_ADMIN_AUTH_FILE (если задано и то и другое,
# приоритет у SHM_ADMIN_AUTH_FILE).
SHM_ADMIN_AUTH=login:password

# Путь к файлу, содержащему строку "login:password" (альтернатива SHM_ADMIN_AUTH,
# чтобы не держать секрет в переменных окружения процесса).
#SHM_ADMIN_AUTH_FILE=/run/secrets/shm_admin_auth

# Режим доступа: "ro" (по умолчанию) — только GET и безопасные операции;
# "rw" — разрешены изменяющие операции (с учётом MCP_DENY и MCP_CONFIRM).
MCP_MODE=ro

# Дополнительные запрещённые правила через запятую, формат "METHOD /prefix"
# или просто "/prefix" (для всех методов). Пример:
# MCP_DENY=POST /admin/user,DELETE /admin/config
MCP_DENY=

# Включает встроенный список опасных операций SHM по умолчанию (см. README):
# GET /admin/server/identity, DELETE /admin/config,
# POST /admin/spool/manual/success|set|add, PUT /admin/spool,
# DELETE /admin/user/pay, DELETE /admin/user/bonus,
# DELETE /admin/user/service/withdraw.
# 1 = включено (по умолчанию), 0 = выключено.
MCP_DENY_DEFAULTS=1

# Требовать confirm:true для не-GET операций (второй вызов-подтверждение).
# По умолчанию 1 в режиме rw. 0 — выполнять не-GET сразу.
MCP_CONFIRM=1

# Если 1 — ни одна не-GET операция никогда не отправляется на сервер,
# всегда возвращается превью (метод, URL, тело).
MCP_DRY_RUN=0

# Путь к файлу аудита JSONL. По умолчанию ./.audit/shm-mcp.jsonl (права 0600).
MCP_AUDIT_LOG=./.audit/shm-mcp.jsonl

# Таймаут HTTP-запросов к SHM, миллисекунды.
MCP_TIMEOUT_MS=30000

# Максимальный размер тела ответа в байтах; при превышении ответ усекается
# с пометкой truncated:true.
MCP_MAX_RESPONSE_BYTES=200000

# Регулярное выражение по имени инструмента — публиковать только совпадающие
# инструменты (снижает контекст клиента). Пусто = публиковать все.
MCP_TOOL_FILTER=

# Редактирование секретов в ответах и аудит-логе. 1 = включено (по умолчанию),
# 0 = выключено (НЕ рекомендуется).
MCP_REDACT=1

# Опциональный Streamable HTTP транспорт (npm run start:http).
#MCP_HTTP_PORT=8787
# Токен для авторизации HTTP-клиентов (обязателен, если используется HTTP).
#MCP_HTTP_TOKEN=change-me
